# SCM 类型：gitlab 或 github
SCM_PROVIDER=gitlab
# Git Clone URL
SCM_REPOSITORY_URL=https://gitlab.example.com/group/project.git
# 默认分支
SCM_DEFAULT_BRANCH=main
# 仓库完整名称：GitLab 为 group/project，GitHub 为 owner/repository
SCM_REPOSITORY=group/project
# Git Clone 和 Push 使用的凭据，不要提交真实值
SCM_GIT_TOKEN=
# GitLab 填站点根地址；GitHub.com 填 https://api.github.com
SCM_API_BASE_URL=https://gitlab.example.com
# Issue、MR/PR、CI API 使用的凭据，不要提交真实值
SCM_API_TOKEN=
